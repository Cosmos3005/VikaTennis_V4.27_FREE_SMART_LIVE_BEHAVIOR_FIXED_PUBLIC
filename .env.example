# Copy this file to .env and put your private Live Tennis API key here.
# NEVER paste the key into Telegram/chat or commit .env to Git.
LIVETENNISAPI_KEY=
TELEGRAM_BOT_TOKEN=

# Vika auto mode
VIKA_TIMEZONE=Europe/Moscow
DAILY_FORECAST_HOUR=9
DAILY_FORECAST_MINUTE=0
LIVE_SCAN_SECONDS=45

# Optional multi-market bookmaker odds feed (The Odds API)
# Enables live h2h + game handicaps + totals when configured.
THE_ODDS_API_KEY=
THE_ODDS_API_SPORT=tennis
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_MARKETS=h2h,spreads,totals
ODDS_CACHE_SECONDS=20
ODDS_HTTP_TIMEOUT=12
